onnx_models/
*.onnx
*.onnx_data
*.model
*.bin
*.pt
*.pth
*.gguf
*.safetensors
android/app/src/main/assets/hf_cache/
# Vendored sherpa-onnx AAR (46 MB) — fetch, don't commit:
# https://github.com/k2-fsa/sherpa-onnx/releases/download/v1.13.4/sherpa-onnx-1.13.4.aar
# -> android/app/libs/
android/app/libs/*.aar

# Python
.venv/
venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Android
android/.gradle/
android/app/build/
android/build/
android/local.properties
android/.idea/
*.keystore

# IDEs
.idea/
.vscode/
*.swp
*.bak
.DS_Store

# Local tooling
.venv-ort122/
.zcode/
.pytest_cache/

# Native third-party caches / tarballs (vendored llama.cpp source stays tracked)
android/app/src/main/cpp/third_party/*.tar.gz
android/app/.cxx/

# Local-only artifacts (never push: 4GB APK exceeds GitHub limits,
# .tmp_rtranslator/ is 1GB RTranslator analysis scratch)
*.apk
.tmp_rtranslator/
